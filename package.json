{
  "name": "flowdock",
  "version": "0.1.0",
  "description": "A fast, native Windows window switcher sidebar",
  "main": "out/main/index.js",
  "author": "FlowDock contributors",
  "license": "MIT",
  "scripts": {
    "predev": "npm run build:native",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:win": "npm run build:native && npm run build && electron-builder --win nsis",
    "pack:win": "npm run build:native && npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.flowdock.app",
    "productName": "FlowDock",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/build/bin/Release/flowdock-native.exe",
        "to": "native/flowdock-native.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "FlowDock-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
